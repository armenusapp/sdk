{
  "name": "@armenus/sdk-react",
  "version": "0.1.0",
  "description": "React components and hooks for rendering Armenus dishes in 3D and AR on the web.",
  "license": "MIT",
  "homepage": "https://armenus.app/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/armenusapp/sdk.git",
    "directory": "js/sdk-react"
  },
  "bugs": {
    "url": "https://github.com/armenusapp/sdk/issues"
  },
  "keywords": [
    "armenus",
    "restaurant",
    "menu",
    "3d",
    "ar",
    "react",
    "model-viewer"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@armenus/sdk-core": "^0.1.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@google/model-viewer": "^4.3.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "oxlint": "^1.76.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2"
  }
}
