# A publishable key. Safe to commit in a real app — it ships in the bundle
# either way — but kept in .env here so the example runs against your data.
VITE_ARMENUS_KEY=pk_live_replace_me

# Which merchant to list. Find it with the SDK's config() call, or in the
# dashboard URL. Leave unset and the example reads the first merchant the
# key can see, which is the only one for a restaurant-scoped key.
# VITE_ARMENUS_MERCHANT_ID=

# Point at a local API during development.
# VITE_ARMENUS_BASE_URL=http://localhost:3001/v1
