# A publishable key. It ships inside the app binary either way — that is what
# `pk_` means — so this file is about pointing the example at your data, not
# about keeping the key secret.
EXPO_PUBLIC_ARMENUS_KEY=pk_live_replace_me

# Optional: a specific merchant. Unset reads the first the key can see.
# EXPO_PUBLIC_ARMENUS_MERCHANT_ID=

# Optional: a local API.
# EXPO_PUBLIC_ARMENUS_BASE_URL=http://localhost:3001/v1
