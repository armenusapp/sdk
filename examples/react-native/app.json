{
  "expo": {
    "name": "Armenus example",
    "slug": "armenus-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "ios": {
      "bundleIdentifier": "app.armenus.example",
      "supportsTablet": true
    },
    "android": {
      "package": "app.armenus.example"
    },
    "plugins": [
      "expo-dev-client",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.0.21"
          }
        }
      ],
      "./plugins/with-kotlin-classpath"
    ]
  }
}
